# ===========================================================================
# Epistora Configuration
# ===========================================================================

# --- Vault & Database ---
VAULT_PATH=./knowledge_vault
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
# Optional bearer token for FastAPI routes such as ingest/query/lint/automation.
# Leave blank for trusted local-only deployments.
EPISTORA_API_KEY=

# --- Ingest (LLM evidence window) ---
# Default max characters of source text sent to the analysis model (non-YouTube).
INGEST_EVIDENCE_MAX_CHARS=16000
# YouTube transcripts are larger; full coverage needs a bigger window or segment digests.
# If the transcript is longer than this, Epistora digests it in chunks before the final pass.
INGEST_YOUTUBE_EVIDENCE_MAX_CHARS=100000
INGEST_YOUTUBE_CHUNK_CHARS=24000

# --- Raindrop.io ---
RAINDROP_API_TOKEN=
RAINDROP_COLLECTION_ID=0

# --- Backend Fallback Order (per-task, comma-separated) ---
# Options: api, opencode, claude_code, codex
BACKEND_ORDER_INGEST=api,opencode,claude_code,codex
BACKEND_ORDER_QUERY=api,opencode,claude_code,codex
BACKEND_ORDER_LINT=api,opencode,claude_code,codex
# If true, unknown tokens in BACKEND_ORDER_* raise instead of being ignored with a warning.
BACKEND_ORDER_STRICT=false

# --- Direct API Backend (global defaults) ---
# These also serve as fallback for the legacy OPENAI_* settings.
API_ENABLED=true
API_BASE_URL=
API_API_KEY=
API_MODEL=
API_TEMPERATURE=0.2

# Legacy OpenAI keys (still work; API_API_KEY / API_MODEL take priority)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- API Per-Task Overrides ---
# Leave blank to use the global API defaults above.
API_BASE_URL_INGEST=
API_API_KEY_INGEST=
API_MODEL_INGEST=

API_BASE_URL_QUERY=
API_API_KEY_QUERY=
API_MODEL_QUERY=

API_BASE_URL_LINT=
API_API_KEY_LINT=
API_MODEL_LINT=

# --- OpenCode CLI Backend ---
OPENCODE_ENABLED=true
OPENCODE_BINARY=opencode
OPENCODE_MODEL=
OPENCODE_MODEL_INGEST=
OPENCODE_MODEL_QUERY=
OPENCODE_MODEL_LINT=
# Ingest (e.g. long YouTube analysis) often needs several minutes over a PTY.
OPENCODE_TIMEOUT_SECONDS=300

# --- Claude Code CLI Backend ---
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_MODEL_INGEST=
CLAUDE_CODE_MODEL_QUERY=
CLAUDE_CODE_MODEL_LINT=
CLAUDE_CODE_TIMEOUT_SECONDS=180

# --- Codex CLI Backend ---
CODEX_ENABLED=true
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_MODEL_INGEST=
CODEX_MODEL_QUERY=
CODEX_MODEL_LINT=
CODEX_TIMEOUT_SECONDS=300

# --- Automation / Worker (legacy interval-based) ---
# Sync uses the configured inbox connector implementation (Raindrop today).
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=1200
SYNC_BATCH_LIMIT=25

AUTO_LINT_ENABLED=false
AUTO_LINT_INTERVAL_SECONDS=86400

AUTO_REBUILD_INDEXES_ENABLED=false
AUTO_REBUILD_INDEXES_INTERVAL_SECONDS=21600

# --- Queue-Based Automation ---
# Master toggle for the new queue-based automation system.
AUTOMATION_ENABLED=false
# Default processing mode: safe (no LLM), balanced (capped LLM), deep (full LLM).
AUTOMATION_DEFAULT_MODE=safe

# Discovery: max bookmarks fetched per discover run.
AUTOMATION_DISCOVER_BATCH_LIMIT=25
# Processing: max items processed per run.
AUTOMATION_PROCESS_LIMIT=10
# Deep enrichment caps to control LLM cost.
AUTOMATION_DEEP_ENRICH_LIMIT_PER_RUN=3
AUTOMATION_DEEP_ENRICH_LIMIT_PER_DAY=20

# Retry: max attempts before marking permanent failure.
AUTOMATION_RETRY_MAX_ATTEMPTS=5
# Retry: base delay in seconds (exponential backoff: base * 2^attempt).
AUTOMATION_RETRY_BASE_SECONDS=60

# Maintenance: run lint and/or index rebuild during automation runs.
AUTOMATION_RUN_LINT=false
AUTOMATION_RUN_REBUILD_INDEXES=false

# Backend order per automation mode (comma-separated).
AUTOMATION_BACKEND_ORDER_SAFE=api,opencode,claude_code,codex
AUTOMATION_BACKEND_ORDER_BALANCED=api,opencode,claude_code,codex
AUTOMATION_BACKEND_ORDER_DEEP=opencode,api,claude_code,codex

# ===========================================================================
# Content Extraction
# ===========================================================================

# --- Article extraction ---
ARTICLE_FETCH_TIMEOUT_SECONDS=30
ARTICLE_USE_READABILITY_FALLBACK=true
ARTICLE_USE_BROWSER_FALLBACK=false

# --- YouTube extraction ---
YOUTUBE_FETCH_TIMEOUT_SECONDS=30
YOUTUBE_USE_YTDLP_FALLBACK=true
# Set to 0 for unlimited transcript length
YOUTUBE_TRANSCRIPT_MAX_CHARS=0

# --- X/Twitter extraction ---
# Official X API (preferred when available, but never required)
X_API_ENABLED=false
X_API_BEARER_TOKEN=
X_API_TIMEOUT_SECONDS=30

# Free mirror fallback (used when X API is unavailable)
X_MIRROR_ENABLED=true
X_MIRROR_TIMEOUT_SECONDS=20
X_OEMBED_ENABLED=true

# --- Browser-rendered fallback (optional, for JS-heavy pages) ---
# Requires playwright: pip install playwright && playwright install chromium
BROWSER_FALLBACK_ENABLED=false
BROWSER_FALLBACK_TIMEOUT_SECONDS=30
