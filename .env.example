# =============================================================================
# Epistora Configuration
# =============================================================================
#
# If you're running Epistora from a source checkout, copy this file to .env:
#   cp .env.example .env
#
# If you're using an installed CLI, run the interactive setup wizard instead:
#   epistora setup
#
# Epistora stores its generated config in the current checkout when run from
# source, or in your OS-specific Epistora config directory when installed.
# Only VAULT_PATH is required. Everything else has sensible defaults.
# =============================================================================

# --- Core Paths ---
# Where your knowledge vault lives (markdown files, indexes, logs)
VAULT_PATH=./knowledge_vault
# SQLite database for internal state (processed sources, sync cursors)
DATABASE_URL=sqlite:///./data/app.db
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Output / storage defaults ---
# Keep markdown_vault as the primary default sink. Add json_export if desired:
# ARTIFACT_SINK_IDS=markdown_vault,json_export
ARTIFACT_SINK_IDS=markdown_vault
# Relative or absolute export path when json_export is enabled
JSON_EXPORT_DIR=.system/exports/json
# Large preserved evidence is stored under the local blob tier by default
EVIDENCE_BLOB_DIR=.system/blobs
# Oversized evidence above this threshold becomes blob-backed
EVIDENCE_BLOB_THRESHOLD_BYTES=50000
# Preview length retained in warm raw notes for blob-backed evidence
EVIDENCE_BLOB_PREVIEW_CHARS=4000

# --- Raindrop.io Connector ---
# Get your token at: https://app.raindrop.io/settings/integrations
RAINDROP_API_TOKEN=
# Collection ID (0 = unsorted / all bookmarks)
RAINDROP_COLLECTION_ID=0

# --- Readwise Reader Connector ---
# Get your token at: https://readwise.io/access_token
READWISE_API_TOKEN=

# =============================================================================
# Backend Configuration
# =============================================================================
#
# Epistora supports multiple LLM backends. You need at least one configured.
# The system tries backends in order and falls back automatically.

# --- Direct API Backend (OpenAI-compatible) ---
API_ENABLED=true
# Your API key (OpenAI, or any OpenAI-compatible provider)
API_API_KEY=
# Model to use
API_MODEL=gpt-4o-mini
# Base URL (leave empty for OpenAI, or set for other providers like Anthropic/Groq/etc.)
# API_BASE_URL=

# Per-task API overrides (optional — leave empty to use the defaults above)
# API_MODEL_INGEST=
# API_MODEL_QUERY=
# API_MODEL_LINT=

# --- OpenCode CLI Backend ---
OPENCODE_ENABLED=true
OPENCODE_BINARY=opencode
# OPENCODE_MODEL=

# --- Claude Code CLI Backend ---
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_BINARY=claude
# CLAUDE_CODE_MODEL=claude-sonnet-4-20250514

# --- Codex CLI Backend ---
CODEX_ENABLED=true
CODEX_BINARY=codex
# CODEX_MODEL=

# --- Backend Fallback Order ---
# Comma-separated list of backends to try, in order.
# Options: api, opencode, claude_code, codex
BACKEND_ORDER_INGEST=api,opencode,claude_code,codex
BACKEND_ORDER_QUERY=api,opencode,claude_code,codex
BACKEND_ORDER_LINT=api,opencode,claude_code,codex
# Set to true to fail on unknown backend names instead of warning
# BACKEND_ORDER_STRICT=false

# =============================================================================
# Automation
# =============================================================================
#
# Queue-based automation (recommended) — run with:
#   epistora automation run-pending
#
# Or schedule it with your OS scheduler:
#   epistora automation generate-scheduler --platform macos

# Master toggle
AUTOMATION_ENABLED=false
# Default mode: safe (no LLM cost), balanced (capped LLM), deep (full analysis)
AUTOMATION_DEFAULT_MODE=safe

# Discovery: max bookmarks fetched per discover run
AUTOMATION_DISCOVER_BATCH_LIMIT=25
# Processing: max items processed per run
AUTOMATION_PROCESS_LIMIT=10
# Deep enrichment caps to control LLM cost
AUTOMATION_DEEP_ENRICH_LIMIT_PER_RUN=3
AUTOMATION_DEEP_ENRICH_LIMIT_PER_DAY=20

# Retry: max attempts before marking permanent failure
AUTOMATION_RETRY_MAX_ATTEMPTS=5
# Retry: base delay in seconds (exponential backoff)
AUTOMATION_RETRY_BASE_SECONDS=60

# Maintenance: run lint and/or index rebuild during automation runs
AUTOMATION_RUN_LINT=false
AUTOMATION_RUN_REBUILD_INDEXES=false

# Backend order per automation mode
AUTOMATION_BACKEND_ORDER_SAFE=api,opencode,claude_code,codex
AUTOMATION_BACKEND_ORDER_BALANCED=api,opencode,claude_code,codex
AUTOMATION_BACKEND_ORDER_DEEP=opencode,api,claude_code,codex

# --- Legacy Worker (interval-based) ---
# SYNC_ENABLED=false
# SYNC_INTERVAL_SECONDS=1200
# SYNC_BATCH_LIMIT=25
# AUTO_LINT_ENABLED=false
# AUTO_REBUILD_INDEXES_ENABLED=false

# =============================================================================
# Content Extraction
# =============================================================================

# --- Article extraction ---
ARTICLE_FETCH_TIMEOUT_SECONDS=30
ARTICLE_USE_READABILITY_FALLBACK=true
ARTICLE_USE_BROWSER_FALLBACK=false

# --- YouTube extraction ---
YOUTUBE_FETCH_TIMEOUT_SECONDS=30
YOUTUBE_USE_YTDLP_FALLBACK=true

# --- X/Twitter extraction ---
# Works without API credentials using free mirror endpoints.
# For better quality, configure the official X API:
X_API_ENABLED=false
# X_API_BEARER_TOKEN=
X_MIRROR_ENABLED=true
X_OEMBED_ENABLED=true

# --- Browser fallback (requires: pip install playwright && playwright install chromium) ---
BROWSER_FALLBACK_ENABLED=false

# --- summarize.sh integration (optional external tool) ---
SUMMARIZE_ENABLED=false
# SUMMARIZE_BINARY=summarize
# SUMMARIZE_TIMEOUT_SECONDS=180

# =============================================================================
# Plugins and Prompt Packs
# =============================================================================
#
# Epistora discovers plugins from:
# - ./plugins inside the repo
# - $EPISTORA_HOME/plugins
# - any directories listed in EPISTORA_PLUGIN_DIRS
#
# Multiple plugin dirs use ':' on macOS/Linux and ';' on Windows.

# EPISTORA_PLUGIN_DIRS=~/my-epistora-plugins
# EPISTORA_PROMPT_PACK=research_pack

# =============================================================================
# API Server (optional)
# =============================================================================

# Optional bearer token for API route authentication
# EPISTORA_API_KEY=

# Legacy OpenAI settings (still used as API backend defaults if API_API_KEY is empty)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
